export type AutomationPlan='off'|'more'|'rest'|'cut'|'share';
export type Offer={wage:number;price:number;ovens:number;automation?:AutomationPlan};
export type Firm={id:number;cash:number;wage:number;price:number;ovens:number;bread:{id:string;day:number}[];debt:number;robot?:boolean;automation?:AutomationPlan};
export type Person={id:number;cash:number;home:number|null;role:'worker'|'owner'|'supplier'};
export type Report={day:number;offers:(Offer|null)[];requested:Offer;everyone:boolean;made:number[];sold:number[];stock:number[];spoiled:number[];income:number[];closed:boolean[];cashBefore:number[];cashAfter:number[];cashChange:number[];fed:number;work?:{person:number;days:number;income:number;kind:string}[];people:{id:number;bought:number;cash:number;visits:{shop:number;success:boolean;reason:string}[]}[];receipts:{from:string;to:string;amount:number;reason:string}[]};
export type Duel={version:number;seed:number;strategy:'mirror'|'bargain'|'steady';day:number;firms:Firm[];people:Person[];history:{before:Omit<Duel,'history'>;offers:(Offer|null)[];requested:Offer;report:Report}[]};
export const DAYS:number;
export const TOTAL_COINS:number;
export const AUTOMATION_PLANS:AutomationPlan[];
export const STRATEGIES:Record<Duel['strategy'],{name:string;rule:string}>;
export function initialDuel(strategy?:Duel['strategy'],seed?:number):Duel;
export function initialTechnologyDuel(strategy?:Duel['strategy'],seed?:number):Duel;
export function currentOffer(s:Duel,id?:number):Offer;
export function offerCost(s:Duel,o:Offer,id?:number):number;
export function offerIssue(s:Duel,o:Offer,id?:number):string;
export function rivalOffer(s:Duel):Offer|null;
export function settleDuel(s:Duel,o:Offer,options?:{everyone?:boolean;allowClosed?:boolean}):Duel;
export function rewindDuel(s:Duel,day:number):Duel;
export function replayEveryone(s:Duel):Duel;
export function restoreDuel(value:unknown):Duel|null;
export function assertDuel(s:Duel):Duel;
export function moneyTotal(s:Duel):number;
